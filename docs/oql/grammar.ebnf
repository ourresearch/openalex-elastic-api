/* OQL (OpenAlex Query Language) v2.2 -- derived reference grammar (W3C-EBNF). */
/* Hand-written from the spec/parser; NOT generated, NOT the parser itself. */
/* Single source of truth = query_translation/oql_lang.py + docs/oql/corpus.yaml. */
/* No-drift gate: tests/oql/test_grammar_ebnf.py (oxjob #361). */
/* Renders to a railroad diagram via the rr tool (oxjob #386 recipe). */

query        ::= 'get'? ( entity | 'each' word setIn? ) ( 'where' conditions )? ( directive | step )*

/* Sets (oxjob #1535): `in (...)` holds a collection, a list of one kind, or a
   whole query in parentheses that returns that kind of thing (type-checked:
   `author is in (...)` takes a query ending `; then get authors of those works`).
   Canonical since oxjob #1555: `in the set (...)`, the query written as a set
   phrase with no `get`: `works where ...`, `authors of works where ...`. */
setIn        ::= 'in' ( 'the'? 'set' )? '(' ( query | setPhrase | scalar ( ',' scalar )* ) ')'

setPhrase    ::= 'the'? word ( 'of' 'the'? word )* ( 'where' conditions )?

entity       ::= word

directive    ::= groupBy | sample | ';'

groupBy      ::= 'group' 'by' word ( ',' word )*

sample       ::= 'sample' NUMBER ( 'seed' NUMBER )?

/* The pipeline language (oxjob #1530; spec: #1512 SYNTAX.md). Canonical form:
   `get works where ...; then group those works by ...; then group those works
   again by ...; then calculate ...`. A calculation is always the last step; up to
   three splits; `those <entity>` must name what the query holds; `again` is
   optional on input and always rendered on every split after the first. */
step         ::= ';'? 'then' ( split | calculation | sampleStep | walk | compare )
               | ';' ( 'summarize' 'using' measures | compare )   /* no step word needed */
/* Comparisons (oxjob #1555, Jason 2026-10-08): the things compared, one group each
   (the summary row is the whole set), breakdowns, and optional measures. Replaces
   split lists and named sets (still accepted; they echo as `compare`). Inside an
   item `is` may go unsaid, a bare value takes the field before it, and a yes/no
   field alone is true: `compare institution [MIT](I63966007) versus [Stanford
   University](I97018004) by year; summarize using count`. */
compare      ::= 'compare' ( 'each' field 'in' 'the'? 'collection' '(' WORD ')'
                           | conditions ( versus conditions )+ )
                 ( ( 'and' | ',' )? 'by' splitBy ( 'where' conditions )? )*
                 ( 'on' measures )?
versus       ::= 'versus' | 'vs' | 'vs.'
measures     ::= measure ( ( ',' | 'and' ) measure )*

/* Walks (oxjob #1535): out from works to related things (`each`: one result per
   thing; the plural: one combined set), then back to everything they did. One
   walk out and one back, before any split; `that` names one thing at a time,
   `those` the set (`get all that author's works`, `get all those authors' works`). */
walk         ::= 'get' ( 'each' word | word ) ( 'of' those )? ( 'where' conditions )?
               | 'get' 'all' ( 'that' | 'those' ) word 'works' ( 'where' conditions )?

split        ::= 'group' those? 'again'? ( 'by' splitBy | 'into' splitInto )
                 ( 'where' conditions )?   /* a group filter: measureClause, the
                                              group's own fields, thatClause */

those        ::= 'those' word+

splitBy      ::= field ( 'search'? 'in' '(' searchItem ( ',' searchItem )* ')'
                       | 'in' '(' scalar ( ',' scalar )* ')'
                       | bins )?

splitInto    ::= '(' '(' conditions ')' ( ',' '(' conditions ')' )* ')'
               | field bins

searchItem   ::= '(' searchExpr ')'     /* up to 5 AND/OR/NOT; up to 100 items */

bins         ::= 'bins' ( 'at' '(' NUMBER ( ',' NUMBER )* ')' | 'of' '(' NUMBER ')' )

calculation  ::= 'calculate' measure ( ( ',' | 'and' ) measure )*

measure      ::= 'count' ( 'of' those )?
               | ( 'mean' | 'median' | 'sum' | 'min' | 'max' ) field ( 'of' those )?
               | 'percent' ( 'of' those | field ( 'of' those )? )

measureClause ::= measure ( '>' | '>=' | '<' | '<=' | 'is' 'not'? ) '(' NUMBER ')'

thatClause   ::= 'that' word+ 'is' 'not'? ( 'in' '(' scalar ( ',' scalar )* ')' | valueGroup )

sampleStep   ::= 'sample' '(' NUMBER ')' ( 'of' those )? ( 'with'? 'seed' '(' scalar ')' )?

/* The `where` body is a boolean of clauses joined by infix `and`/`or`; a 2+
   body renders as the implicit-AND list `a and b`, and explicit groups use
   bare parens `(a or b)` / `(a and b)`. */
conditions   ::= operand ( connective operand )*

connective   ::= 'and' | '&' | 'or'   /* '&' is an input synonym for 'and'; canonical render is always 'and' */

operand      ::= 'not' operand
               | '(' conditions ')'
               | clause

clause       ::= determiner? ( valueClause | searchClause ) | relationClause

/* The work's own relations (#557), negated on the verb (oxjob #1535), taking
   listed works or a set of works: `it cites works in (get works where ...)`. */
relationClause ::= ( 'it' ( 'cites' | "doesn't" 'cite' | 'does' 'not' 'cite'
                          | 'is' 'not'? ( 'cited' 'by' | 'related' 'to' )
                          | "isn't" ( 'cited' 'by' | 'related' 'to' ) )
                   | ( "it's" | 'its' ) 'not'? ( 'cited' 'by' | 'related' 'to' ) )
                   ( value | ( 'a' | 'any' )? ( 'work' | 'works' ) setIn )

/* An optional leading determiner 'the' is ignorable input sugar before a
   field name (`the title is foo`), so a clause can read like a sentence. It is
   dropped at parse and never round-trips (the canonical render omits it). It is
   only swallowed when a known field follows -- a semantic guard, not
   grammatical -- so a search value that opens with "the"
   (`title has (the great gatsby)`) keeps it. */
determiner   ::= 'the'

valueClause  ::= field operator value

field        ::= word+

operator     ::= 'is' 'not'? 'in' 'collection'
               | 'is' 'not'? setIn     /* a set: `is in the set (col_x)`, `is in (A, B)` */
               | 'is' 'not'?
               | 'is' 'similar' 'to'
               | 'has'
               | ( 'does' 'not' | "doesn't" | 'doesnt' ) 'have'
               | '>=' | '<=' | '>' | '<'
               | '=' | '=='              /* input synonyms for 'is'; canonical render is 'is' */

/* The CANONICAL value form is always the parenthesized group (oxjob #554,
   spec v2.2) -- `type is (article)`, `year >= (2019)`; the bare scalar /
   bare 'unknown' alternatives are the accepted-input (lenient) layer only.
   Scalar-domain operators (comparisons, booleans, collection, similar-to)
   take exactly ONE item in their group -- a semantic rule, not grammatical. */
value        ::= valueGroup | 'unknown' | 'null' | scalar   /* a boolean's value is 'true' or 'false' (oxjob #363) */

/* A value group is a parenthesized boolean of values: `(a or b)` / `(a and b)`,
   nesting freely. Items are joined by infix 'or'/'and' (one separator per
   level); bare adjacency between value items is a loud error (#554), never an
   implicit AND. 'unknown'/'null' inside a group is the null sentinel (#554). */
valueGroup   ::= '(' valueExpr ')'

valueExpr    ::= valueItem ( connective valueItem )*

valueItem    ::= 'not'? ( valueGroup | 'unknown' | 'null' | scalar )

scalar       ::= ( WORD | NUMBER | STRING ) ANNOT?

searchClause ::= searchField ( 'has' | ( 'does' 'not' | "doesn't" | 'doesnt' ) 'have' ) searchExpr
               | searchField 'is' 'similar' 'to' ( '(' STRING ')' | STRING )

searchField  ::= word ( ( '&' | 'and' ) word )*

searchExpr   ::= termRun ( connective termRun )*

termRun      ::= searchOperand+

searchOperand ::= 'not' searchOperand
               | proximity
               | '(' searchExpr ')'
               | searchAtom

/* Proximity is one leading list operator: K (2+) operands within an N-word
   window of each other, unordered (oxjob #514). Quotes freeze an operand into
   an adjacent phrase; bare operands stem. (The legacy `within N words` suffix
   and `within N words of` binary forms were removed from the OQL surface; the
   OXURL `~` notation keeps single/binary proximity unchanged.) */
proximity    ::= 'within' NUMBER '(' term ( ',' term )+ ')'

searchAtom   ::= 'stemmed'? term

term         ::= STRING | word

word         ::= WORD | NUMBER

WORD         ::= wordChar+

NUMBER       ::= [0-9]+

STRING       ::= '"' [#x20-#x10FFFF]* '"'

ANNOT        ::= '[' [#x20-#x10FFFF]* ']'

wordChar     ::= [#x21-#x10FFFF]
